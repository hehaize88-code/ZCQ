---
import ArticleCards from './ArticleCards.astro';
import Icon from './Icon.astro';
import {localized} from '../lib/i18n';
import {SOURCE_URLS,readingMinutes,jsonLd} from '../lib/editorial';
const {kind,data,article,lang,origin}=Astro.props;
const ui=data.ui;
const updated=article?.modified||'2026-10-21';
const displayDate=(date:string)=>date.split('-').reverse().join(' / ');
const newest=[...data.articles].sort((a:any,b:any)=>(b.published||'').localeCompare(a.published||''));
const url=(path:string)=>localized(lang,path);
const articleUrl=(slug:string)=>url('/articles/'+slug+'/');
const official=(id:string)=>SOURCE_URLS[id];
const faqGroups=Object.keys(ui.faqGroups);
const related=article?article.related.map((slug:string)=>data.articles.find((a:any)=>a.slug===slug)).filter(Boolean):[];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:ui.articlesLabel,item:new URL(url('/articles/'),origin).href},...(article?[{'@type':'ListItem',position:2,name:article.title,item:new URL(articleUrl(article.slug),origin).href}]:[])]};
const schema=kind==='faq'?{'@context':'https://schema.org','@type':'FAQPage',inLanguage:lang,mainEntity:data.faq.map((item:any)=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))}:article?{'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,inLanguage:lang,datePublished:article.published||'2026-10-17',dateModified:article.modified||'2026-10-17',mainEntityOfPage:new URL(articleUrl(article.slug),origin).href,author:{'@type':'Organization',name:'Pikobuy Sheet'},publisher:{'@type':'Organization',name:'Pikobuy Sheet'}}:{'@context':'https://schema.org','@type':'CollectionPage',name:ui.articlesTitle,inLanguage:lang};
---
<script type="application/ld+json" set:html={jsonLd(schema)}/>
{kind!=='faq'&&<script type="application/ld+json" set:html={jsonLd(breadcrumb)}/>}
{kind==='faq'&&<section class="editorial-page wrap faq-page">
 <div class="editorial-heading"><span class="eyebrow">PIKOBUY · {ui.faqCount}</span><h1>{ui.faqTitle}</h1><p>{ui.faqIntro}</p><div class="editorial-meta"><span>{data.faq.length} {ui.faqCount}</span><span>{ui.updated} · <time datetime="2026-10-17">17 / 10 / 2026</time></span></div></div>
 <div class="faq-tools"><label class="faq-search"><Icon name="search"/><input id="faq-search" type="search" placeholder={ui.faqSearch} aria-label={ui.faqSearch}/></label><nav class="topic-links" aria-label={ui.contents}>{faqGroups.map((group:string)=><a href={'#faq-'+group}>{ui.faqGroups[group]}</a>)}</nav></div>
 <p class="faq-no-match" id="faq-no-match" role="status" aria-live="polite" hidden>{ui.noMatch}</p>
 <div class="faq-groups">{faqGroups.map((group:string)=><section class="faq-group" id={'faq-'+group}><h2>{ui.faqGroups[group]}</h2><div class="faq-answers">{data.faq.filter((item:any)=>item.group===group).map((item:any)=><details class="faq-item" id={item.id} data-faq-item><summary>{item.q}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{item.a}</p><div class="answer-links">{item.related&&<a href={articleUrl(item.related)}>{ui.readGuide}<Icon name="arrow" size={14}/></a>}{item.sourceIds.filter((id:string)=>official(id)).map((id:string)=><a href={official(id)} target="_blank" rel="noopener noreferrer">{ui.sourceNames[id]}<Icon name="external" size={12}/></a>)}</div></div></details>)}</div></section>)}</div>
 <div class="editorial-note"><Icon name="check"/><p>{ui.sourceNote}</p></div>
</section>}
{kind==='articles'&&<section class="editorial-page wrap"><div class="editorial-heading"><span class="eyebrow">PIKOBUY · {ui.articlesLabel}</span><h1>{ui.articlesTitle}</h1><p>{ui.articlesIntro}</p><div class="editorial-meta"><span>{data.articles.length} {ui.articlesCount}</span><span>{ui.updated} · {displayDate(updated)}</span></div></div><ArticleCards articles={newest} lang={lang} ui={ui}/><div class="editorial-note"><Icon name="check"/><p>{ui.editorialNote}</p></div></section>}
{article&&<article class="editorial-page wrap article-page">
 <nav class="article-breadcrumb" aria-label={ui.backArticles}><a href={url('/articles/')}>{ui.articlesLabel}</a><Icon name="chevron" size={12}/><span>{article.category}</span></nav>
 <header class="article-heading"><span class="eyebrow">{article.category}</span><h1>{article.title}</h1><p class="article-lead">{article.intro}</p><div class="editorial-meta"><span>{ui.updated} · <time datetime={updated}>{displayDate(updated)}</time></span><span>{readingMinutes(article)} {ui.minRead}</span></div></header>
 <div class="article-layout"><aside class="article-toc"><details open><summary>{ui.onThisPage}<Icon name="chevron" size={14}/></summary><nav>{article.sections.map((section:any,index:number)=><a href={'#section-'+(index+1)}><span>{String(index+1).padStart(2,'0')}</span>{section.heading}</a>)}</nav></details></aside>
 <div class="article-body">{article.checks?.length>0&&<aside class="quick-answer"><h2>{ui.quickAnswer}</h2><ul>{article.checks.map((check:string)=><li>{check}</li>)}</ul><a class="text-link" data-track="article_catalog_click" href={article.collection?url('/categories/'+article.collection+'/'):url('/spreadsheet/')}>{article.collection?ui.categoryTitles[article.collection==='shoes'?0:1]:ui.continueExploring}<Icon name="arrow" size={16}/></a></aside>}{article.sections.map((section:any,index:number)=><section id={'section-'+(index+1)}><h2>{section.heading}</h2>{section.paragraphs.map((p:string)=><p>{p}</p>)}{section.bullets?.length&&<ul>{section.bullets.map((b:string)=><li>{b}</li>)}</ul>}</section>)}
 <aside class="article-sources"><h2>{ui.sources}</h2><p>{ui.sourceNote}</p><ul>{article.sourceIds.filter((id:string)=>official(id)).map((id:string)=><li><a href={official(id)} target="_blank" rel="noopener noreferrer">{ui.sourceNames[id]}<Icon name="external" size={14}/></a></li>)}</ul><p>{ui.editorialNote}</p></aside>
 <div class="article-actions"><a class="button dark" data-track="article_catalog_click" href={article.collection?url('/categories/'+article.collection+'/'):url('/spreadsheet/')}>{ui.continueExploring}<Icon name="arrow" size={16}/></a><a href={url('/faq/')}>{ui.faqTitle}</a></div></div></div>
 {related.length>0&&<section class="article-related"><div class="section-heading"><h2>{ui.relatedTitle}</h2><a class="text-link" href={url('/articles/')}>{ui.allArticles}<Icon name="arrow" size={16}/></a></div><ArticleCards articles={related} lang={lang} ui={ui} compact/></section>}
</article>}
<script>
 const search=document.querySelector<HTMLInputElement>('#faq-search');
 search?.addEventListener('input',()=>{
  const q=search.value.trim().toLocaleLowerCase();let found=0;
  document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]').forEach(item=>{const match=(item.textContent||'').toLocaleLowerCase().includes(q);item.hidden=!match;if(match)found++;});
  document.querySelectorAll<HTMLElement>('.faq-group').forEach(group=>{group.hidden=!group.querySelector('[data-faq-item]:not([hidden])');});
  const empty=document.querySelector<HTMLElement>('#faq-no-match');if(empty)empty.hidden=found>0;
 });
 document.querySelectorAll<HTMLAnchorElement>('.topic-links a').forEach(link=>link.addEventListener('click',()=>{if(search){search.value='';search.dispatchEvent(new Event('input'));}}));
 if(window.matchMedia('(max-width:850px)').matches)document.querySelector('.article-toc details')?.removeAttribute('open');
</script>
