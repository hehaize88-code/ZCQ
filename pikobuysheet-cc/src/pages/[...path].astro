---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import {SITE_ORIGIN,isProductionHost} from '../lib/site';
import {sitemapLabel} from '../lib/directory';
import Icon from '../components/Icon.astro';
import EditorialPage from '../components/EditorialPage.astro';
import ArticleCards from '../components/ArticleCards.astro';
import {loadEditorial} from '../lib/editorial';
import Card from '../components/Card.astro';
import {languages,translate,categoryNames,localized} from '../lib/i18n';
import {editorial} from '../lib/copy';
import {catalogFor,price,categories,REGISTER,buyLink,ORIGIN,safeCatalog,safeProduct} from '../lib/catalog';
import {SourceHttpError,SourceRetryError} from '../lib/source-cache';
// Astro may normalize .html when matching catch-all params; upstream product
// URLs require that suffix. Preserve the actual request path for data and locales.
const {getCatalog,getProduct,getRate,getSku,getQc}=catalogFor(Astro.locals.sourceCache);
const segments=new URL(Astro.request.url).pathname.split('/').filter(Boolean);
const lang=languages.some(([id])=>id===segments[0])?segments.shift()!:'en';
const route='/'+segments.join('/');const t=translate(lang);const c=editorial(lang);const names=categoryNames(lang);
const content=await loadEditorial(lang);const ui=content.ui;
const faq=route==='/faq';const articleIndex=route==='/articles';const articleSlug=route.startsWith('/articles/')?route.slice('/articles/'.length):'';const article=content.articles.find(a=>a.slug===articleSlug);
const collectionIndex=['/categories/shoes','/categories/hoodies'].indexOf(route);const collection=collectionIndex>=0;
const collectionSource=collectionIndex===0?'/shoes/':'/hoodies-sweaters/';
const collectionArticle=content.articles.find(a=>a.slug===(collectionIndex===0?'pikobuy-sneaker-finds':'pikobuy-hoodie-finds'));
const home=route==='/';const detail=route.startsWith('/products/');const visual=route==='/search/visual';const guide=route==='/guide';const catalog=route==='/spreadsheet';
let error=false;let invalid=!(home||detail||visual||guide||catalog||faq||articleIndex||article||collection);
let listing:any={products:[],sorts:[],pages:[]};let product:any=null;let sku:any=null;let qc:any={status:'unavailable',images:[]};
const qcRequested=detail&&Astro.url.searchParams.get('qc')==='1';
let query=(Astro.url.searchParams.get('q')||'').slice(0,120);
let source='/AllProducts/';
try {source=query?'/search.html?'+new URLSearchParams({keywords:query,channelid:'2'}):safeCatalog(Astro.url.searchParams.get('source')||'/AllProducts/');}catch{invalid=true;}
if(collection)source=collectionSource;
if(!query)query=new URL(source,ORIGIN).searchParams.get('keywords')||'';
if(detail){try{safeProduct(route.slice('/products'.length));}catch{invalid=true;}}
let rate:number|undefined;let retryAfter=60;
try {
 if(!invalid&&(home||catalog||collection))listing=await getCatalog(home?'/AllProducts/':source);
 if(!invalid&&detail){product=await getProduct(route.slice('/products'.length));// QC is optional and requested only when a visitor submits its form.
 // Fetching it for every crawler visit repeatedly triggered source-wide 429 cooldowns.
 [sku,qc]=await Promise.all([product.partial?Promise.resolve(null):getSku(product.id),qcRequested?getQc(product.id):Promise.resolve(qc)]);}
 // Fetch optional exchange rates only after real product data is available.
 // A missing/limited product must not generate another upstream request.
 if(!invalid&&(home||catalog||detail||collection))rate=await getRate();
}catch(e){
 if(e instanceof SourceHttpError&&(e.status===404||e.status===410)&&!collection){invalid=true;}
 else {error=true;if(e instanceof SourceRetryError)retryAfter=Math.max(1,Math.ceil((e.retryAt-Date.now())/1000));console.error("FindSpreadsheet source unavailable",{path:Astro.url.pathname,reason:e instanceof Error?e.message:'Unknown source error',retryAfter});}
}
if(invalid)Astro.response.status=404;
// Product recommendations are optional on the editorial homepage. A source
// outage must not remove its independent guides, articles and FAQs from search.
const unavailable=error&&!home&&!collection;
if(unavailable){Astro.response.status=503;Astro.response.headers.set('Retry-After',String(retryAfter));}
if(error||product?.partial)Astro.response.headers.set('Cache-Control','no-store');
const production=isProductionHost(Astro.url);
const indexable=production&&!invalid&&!unavailable&&!visual&&!Astro.url.search;
const robots=indexable?'index, follow':'noindex, follow';
Astro.response.headers.set('X-Robots-Tag',robots);
const url=(path:string)=>localized(lang,path);
const catalogLink=(path:string)=>path==='/shoes/'?url('/categories/shoes/'):path==='/hoodies-sweaters/'?url('/categories/hoodies/'):url('/spreadsheet/')+'?source='+encodeURIComponent(path);
const currentPath=route==='/'?'/':route+(route.endsWith('.html')?'':'/');
// Preserve the selected category even when its source response is unavailable.
const activeCategory=categories.findIndex(x=>listing.activeCategory===`/${x}/`||source.startsWith(`/${x}/`));
const categoryTitle=activeCategory>=0?names[activeCategory]:t.all;
const title=collection?ui.categoryTitles[collectionIndex]+' | Pikobuy Sheet':article?article.title+' | Pikobuy Sheet':faq?ui.faqTitle+' | Pikobuy Sheet':articleIndex?ui.articlesTitle+' | Pikobuy Sheet':guide?ui.guideTitle+' | Pikobuy Sheet':product?`${product.title} | Pikobuy Spreadsheet`:home?ui.homeTitle:visual?`${t.visual} | Pikobuy Spreadsheet`:guide?`${t.guide} | Pikobuy Spreadsheet`:`${query||categoryTitle} | Pikobuy Spreadsheet`;
const hero=listing.products.slice(0,3);
const sortLabels:Record<string,string>={new:t.latest,click:t.popular,price:lang==='en'?'Price':t.price};
const attrs=sku?.specifications?.attrs||[];
const pageDescription=collection?ui.categoryIntros[collectionIndex].split('. ')[0]+'.':article?article.description:faq?ui.faqIntro:articleIndex?ui.articlesIntro:guide?ui.guideIntro:c.intro;
const canonical=new URL(url(currentPath),SITE_ORIGIN).href;
---
<!doctype html><html lang={lang}><head>{production&&<Analytics/>}<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content={robots}/><meta name="description" content={pageDescription}/><meta name="theme-color" content="#7de8de"/><title>{title}</title><link rel="icon" href="/brand/favicon.png" type="image/png"/><link rel="canonical" href={canonical}/>{!invalid&&languages.map(([id])=><link rel="alternate" hreflang={id} href={new URL(localized(id,currentPath),SITE_ORIGIN).href}/>)}{!invalid&&<link rel="alternate" hreflang="x-default" href={new URL(currentPath,SITE_ORIGIN).href}/>}<meta property="og:title" content={title}/><meta property="og:description" content={pageDescription}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/></head>
<body>
<div class="topline"><div class="wrap"><span><span class="status-dot"></span> {!production&&<>{t.preview} · </>}pikobuysheet.cc</span><span class="source-credit">FindSpreadsheet <span>×</span> Pikobuy</span></div></div>
<header class="header"><div class="wrap nav">
 <a class="brand" href={url('/')} aria-label="Pikobuy Sheet"><img src="/brand/logo.png" alt="Pikobuy" width="150" height="42"/><span class="brand-divider"></span><span class="brand-sheet">SHEET</span></a>
 <nav id="primary-nav" aria-label="Pikobuy"><a class:list={{active:home||catalog||detail||collection}} href={url('/spreadsheet/')}>{t.browse}</a><a class:list={{active:guide}} href={url('/guide/')}>{t.guide}</a><a class:list={{active:faq}} href={url('/faq/')}>{t.faq}</a><a class:list={{active:articleIndex||!!article}} href={url('/articles/')}>{ui.articlesLabel}</a></nav>
 <div class="nav-actions"><button class="menu-toggle" id="menu-toggle" aria-label={ui.menu} aria-expanded="false" aria-controls="primary-nav"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><div class="language-picker"><Icon name="globe" size={17}/><select id="language" aria-label={t.language}>{languages.map(([id,name])=><option value={localized(id,currentPath)+Astro.url.search} selected={id===lang}>{name}</option>)}</select></div><a class="button dark small register" data-track="registration_click" href={REGISTER} target="_blank" rel="noopener noreferrer">{t.register}<Icon name="external" size={14}/></a></div>
</div></header>
<main data-catalog-retry={error&&(home||catalog)?retryAfter:undefined}>
{home&&<>
<section class="hero wrap"><div class="hero-copy"><span class="eyebrow"><span class="mini-line"></span> PIKOBUY SPREADSHEET</span><h1>Pikobuy<br/>{' '}<span>{ui.homeHeadline}</span></h1><h2>{c.tagline}</h2><p>{c.intro}</p>
<form class="search-box" action={url('/spreadsheet/')} method="get"><Icon name="search"/><input name="q" aria-label={t.search} placeholder={t.placeholder} maxlength="120" required/><button aria-label={t.search} type="submit"><Icon name="arrow"/></button></form>
<div class="hero-links"><a href={url('/search/visual/')}><Icon name="camera" size={17}/>{t.visual}</a><span></span><a href={url('/spreadsheet/')}>{t.all}<Icon name="arrow" size={15}/></a></div>
</div><div class="hero-showcase" aria-label={t.popular}><div class="orbit-label"><Icon name="star" size={16}/>{t.popular}</div><div class="hero-grid">{hero.map((p:any,i:number)=><a class={`hero-item hero-item-${i}`} href={url('/products'+p.path)}><div class="hero-image"><img src={p.image} alt={p.title} width="420" height="420" loading="eager" referrerpolicy="no-referrer"/></div><div class="hero-item-meta"><span>{p.title}</span><strong>{price(p.rawPrice,rate,lang)}</strong></div></a>)}</div>{!hero.length&&<div class="empty">{error?c.error:t.empty}</div>}<span class="showcase-caption">{t.photos} · FindSpreadsheet</span></div></section>
<div class="benefits wrap"><div><Icon name="grid"/><span>{t.categories}</span><b>11</b></div><div><Icon name="camera"/><span>{t.photos}</span></div><div><Icon name="globe"/><span>{t.language}</span><b>24</b></div><a href={url('/guide/')}><Icon name="bag"/><span>{t.guide}</span><Icon name="arrow" size={16}/></a></div>
</>}
{collection&&<section class="collection-intro wrap"><nav class="article-breadcrumb"><a href={url('/spreadsheet/')}>{t.browse}</a><Icon name="chevron" size={12}/><span>{names[collectionIndex]}</span></nav><h1>{ui.categoryTitles[collectionIndex]}</h1><p>{ui.categoryIntros[collectionIndex]}</p><ul>{collectionArticle?.checks?.map(check=><li>{check}</li>)}</ul><a class="text-link" href={url('/articles/'+collectionArticle?.slug+'/')}>{ui.readGuide}<Icon name="arrow" size={16}/></a></section>}
{(home||catalog||collection)&&!invalid&&<section class="catalog-section wrap" id="collection"><div class="section-heading"><div><span class="eyebrow">{home?t.browse:'PIKOBUY SPREADSHEET'}</span><h2>{home?t.catalog:query?`${t.search}: “${query}”`:categoryTitle}</h2></div>{home?<a class="text-link" href={url('/spreadsheet/')}>{t.all}<Icon name="arrow"/></a>:<span class="result-count">{listing.products.length} {t.results}</span>}</div>
<div class="catalog-layout"><aside class="sidebar"><h3><Icon name="grid" size={17}/>{t.categories}</h3><details class="category-menu" open><summary><span><Icon name="grid" size={17}/>{t.categories}</span><Icon name="chevron" size={14}/></summary><div class="category-options"><a class:list={{selected:activeCategory<0&&!query}} href={url('/spreadsheet/')}>{t.all}<span>↗</span></a>{categories.map((cat,i)=><a class:list={{selected:activeCategory===i}} href={catalogLink('/'+cat+'/')}>{names[i]}<Icon name="chevron" size={13}/></a>)}</div></details><div class="sidebar-note"><Icon name="bag" size={24}/><strong>{c.howTitle}</strong><a href={url('/guide/')}>{t.guide} ↗</a></div></aside>
<div class="catalog-main"><div class="catalog-toolbar">{(catalog||collection)?<form class="catalog-search" action={url('/spreadsheet/')}><Icon name="search" size={18}/><input name="q" value={query} placeholder={t.placeholder} aria-label={t.search} maxlength="120" required/><button type="submit" aria-label={t.search}><Icon name="arrow" size={18}/></button></form>:<span class="toolbar-label"><span class="status-dot"></span>{t.popular}</span>}<div class="sort-links">{listing.sorts.map((s:any)=><a class:list={{selected:s.active}} href={catalogLink(s.path)}>{sortLabels[s.key]}{s.key==='price'?' ↕':''}</a>)}</div></div>
{error?<div class="empty"><Icon name="grid" size={32}/><h3>{t.unavailable}</h3><p>{c.error}</p><a class="button dark" href={Astro.url.pathname+Astro.url.search}>{t.retry}</a></div>:listing.products.length?<div class="product-grid">{listing.products.slice(0,home?12:undefined).map((p:any,i:number)=><Card product={p} lang={lang} t={t} rate={rate} eager={i<4}/>)}</div>:<div class="empty"><p>{t.empty}</p><a class="button dark" href={url('/spreadsheet/')}>{t.clear}</a></div>}
{home?<div class="browse-more"><a class="button outlined" href={url('/spreadsheet/')}>{t.all}<Icon name="arrow"/></a></div>:<nav class="pagination" aria-label={t.browse}>{listing.pages.map((p:any)=>p.path?<a href={catalogLink(p.path)}>{p.text==='Next'?t.next:p.text==='Pre'?t.previous:p.text}</a>:<span class:list={{selected:p.active}}>{p.text==='Next'?t.next:p.text==='Pre'?t.previous:p.text}</span>)}</nav>}
</div></div></section>}
{detail&&product&&<section class="detail wrap"><div class="breadcrumbs"><a href={url('/spreadsheet/')}>{t.browse}</a><Icon name="chevron" size={12}/><span>{product.title}</span></div><div class="detail-layout"><div class="gallery"><div class="main-photo">{product.images[0]?<img id="main-image" src={product.images[0]} alt={product.title} width="650" height="650" referrerpolicy="no-referrer"/>:<span>{t.photoMissing}</span>}</div><div class="thumbnails">{product.images.map((im:string,i:number)=><button type="button" data-image={im} class:list={{selected:i===0}} aria-label={`${t.photos} ${i+1}`}><img src={im} alt={`${product.title} ${i+1}`} width="90" height="90" loading="lazy" referrerpolicy="no-referrer"/></button>)}</div></div><div class="product-summary"><span class="eyebrow">PIKOBUY SPREADSHEET</span><h1>{product.title}</h1><p class="source-id">Weidian · ID {product.id}</p><div class="detail-price">{price(product.rawPrice,rate,lang)}<span>{rate?'USD':'CNY'}</span></div><p class="price-note">{c.priceNote}</p>{product.partial&&<p class="detail-summary-notice" role="status">{t.summaryOnly}</p>}<div class="sku-section">{attrs.length?attrs.map((group:any)=><label class="sku-group"><span>{group.attr_title}</span><select class="sku-select" data-group={group.attr_title}><option value="">—</option>{group.attr_values.map((v:any)=><option value={v.attr_id} data-img={v.img?new URL(v.img,ORIGIN).href:''}>{v.attr_value}</option>)}</select></label>):!product.partial&&<p class="muted">{t.unavailable}</p>}</div>{buyLink(product.id)&&<a class="button yellow buy-button" data-track="purchase_click" data-item-id={product.id} href={buyLink(product.id)} target="_blank" rel="noopener noreferrer nofollow">{t.buy}<Icon name="external"/></a>}<a class="original-link" href={ORIGIN+product.path} target="_blank" rel="noopener noreferrer">FindSpreadsheet · {t.source}<Icon name="external" size={14}/></a><div class="detail-note"><Icon name="check"/><p>{c.how}</p></div></div></div><section class="qc-section" id="qc"><div class="section-heading"><h2>QC · {t.photos}</h2><span class="source-credit">FindSpreadsheet</span></div>{!qcRequested?<form class="qc-empty" action={url(currentPath)+'#qc'} method="get"><Icon name="camera" size={26}/><button class="button dark" type="submit" name="qc" value="1">{t.loadQc}</button></form>:qc.images.length?<div class="qc-grid">{qc.images.map((im:any)=><figure><a href={im.url} target="_blank" rel="noopener noreferrer"><img src={im.url} alt={im.label||'QC'} loading="lazy" referrerpolicy="no-referrer"/></a><figcaption>{im.label}</figcaption></figure>)}</div>:<div class="qc-empty"><Icon name="camera" size={26}/><strong>{t.unavailable}</strong><a href={ORIGIN+product.path} target="_blank" rel="noopener noreferrer">{t.source} ↗</a></div>}</section>{product.related.length>0&&<section class="related"><div class="section-heading"><h2>{t.related}</h2></div><div class="product-grid">{product.related.slice(0,4).map((p:any)=><Card product={p} lang={lang} t={t} rate={rate}/>)}</div></section>}</section>}
{home&&<section class="how-section wrap" id="how"><div class="how-intro"><span class="eyebrow">{t.guide}</span><h2>{c.howTitle}</h2><p>{c.how}</p><a class="button dark" data-track="registration_click" href={REGISTER} target="_blank" rel="noopener noreferrer">{t.register}<Icon name="external" size={16}/></a></div><div class="steps"><div><span>01</span><Icon name="search" size={26}/><h3>{t.search}</h3><p>{t.placeholder.replace('…','')}</p></div><div><span>02</span><Icon name="camera" size={26}/><h3>{t.photos}</h3><p>{t.view} · QC</p></div><div><span>03</span><Icon name="bag" size={26}/><h3>{t.buy}</h3><a href="https://www.pikobuy.com/guide" target="_blank" rel="noopener noreferrer">Pikobuy · {t.guide} ↗</a></div></div></section>}
{guide&&<section class="editorial-page wrap guide-page"><div class="editorial-heading"><span class="eyebrow">PIKOBUY · {t.guide}</span><h1>{ui.guideTitle}</h1><p>{ui.guideIntro}</p><a class="text-link" href={url('/articles/pikobuy-ordering-guide/')}>{ui.guideDetails}<Icon name="arrow"/></a></div><div class="guide-stages">{ui.guideSteps.map((step:any,index:number)=><section><span>{String(index+1).padStart(2,'0')}</span><div><h2>{step.title}</h2><p>{step.body}</p></div></section>)}</div><div class="editorial-note"><Icon name="check"/><p>{ui.sourceNote} <a href="https://www.pikobuy.com/guide" target="_blank" rel="noopener noreferrer">{ui.sourceNames.guide} ↗</a></p></div></section>}
{home&&<section class="home-articles wrap"><div class="section-heading"><div><span class="eyebrow">{ui.articlesLabel}</span><h2>{ui.homeArticlesTitle}</h2></div><a class="text-link" href={url('/articles/')}>{ui.allArticles}<Icon name="arrow" size={16}/></a></div><ArticleCards articles={['pikobuy-sneaker-finds','pikobuy-hoodie-finds','pikobuy-fees','pikobuy-shipping-cost','pikobuy-ordering-guide','pikobuy-review-checklist'].map(slug=>content.articles.find(a=>a.slug===slug)).filter(Boolean)} lang={lang} ui={ui} compact/></section>}
{home&&<section class="faq-section wrap" id="faq"><div><span class="eyebrow">PIKOBUY FAQ</span><h2>{ui.homeFaqTitle}</h2><a class="text-link" href={url('/faq/')}>{ui.viewAllFaq}<Icon name="arrow" size={16}/></a></div><div class="faqs">{[content.faq[0],content.faq[8],content.faq[11],content.faq[21]].map(item=><details><summary>{item.q}<span>+</span></summary><p>{item.a}</p></details>)}</div></section>}
{faq&&<EditorialPage kind="faq" data={content} lang={lang} origin={SITE_ORIGIN}/>}
{articleIndex&&<EditorialPage kind="articles" data={content} lang={lang} origin={SITE_ORIGIN}/>}
{article&&<EditorialPage kind="article" data={content} article={article} lang={lang} origin={SITE_ORIGIN}/>}
{visual&&<section class="visual-page wrap"><span class="eyebrow">PIKOBUY SPREADSHEET</span><h1>{t.visual}</h1><div class="visual-panel"><Icon name="camera" size={48}/><h2>{t.unavailable}</h2><p>{c.visualNote}</p><form class="search-box" action={url('/spreadsheet/')}><Icon name="search"/><input name="q" placeholder={t.placeholder} aria-label={t.search} required/><button type="submit" aria-label={t.search}><Icon name="arrow"/></button></form></div></section>}
{(invalid||(detail&&error))&&<section class="empty wrap"><h1>{invalid?'404':t.unavailable}</h1><p>{error?c.error:t.empty}</p><a class="button dark" href={url('/spreadsheet/')}>{t.back}</a></section>}
</main>
<footer><div class="wrap footer-main"><div><a class="brand" href={url('/')}><img src="/brand/logo.png" alt="Pikobuy" width="140" height="40"/><span class="brand-sheet">SHEET</span></a><p>{c.disclosure}</p></div><div class="footer-links"><a href={url('/categories/shoes/')}>{names[0]}</a><a href={url('/categories/hoodies/')}>{names[1]}</a><a href={url('/sitemap/')}>{sitemapLabel(lang)}</a><a href={url('/spreadsheet/')}>{t.browse}</a><a href={url('/guide/')}>{t.guide}</a><a href={url('/faq/')}>{t.faq}</a><a href={url('/articles/')}>{ui.articlesLabel}</a><a href="https://www.pikobuy.com/shipping-cost" target="_blank" rel="noopener noreferrer">Pikobuy ↗</a><a href="https://findspreadsheet.com/" target="_blank" rel="noopener noreferrer">FindSpreadsheet ↗</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} pikobuysheet.cc</span><span>{!production&&<>{t.preview} · </>}{t.price}</span><a href={url('/')}>{t.home} ↑</a></div></footer>
<script>
 import {scheduleCatalogRecovery} from '../lib/catalog-recovery';
 scheduleCatalogRecovery(document,window);
 const categoryMenu=document.querySelector<HTMLDetailsElement>('.category-menu');
 const compactCategories=window.matchMedia('(max-width:850px)');
 const setCategoryLayout=()=>{if(categoryMenu)categoryMenu.open=!compactCategories.matches;};
 setCategoryLayout();compactCategories.addEventListener('change',setCategoryLayout);
 document.querySelector<HTMLButtonElement>('#menu-toggle')?.addEventListener('click',event=>{const b=event.currentTarget as HTMLButtonElement;const expanded=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!expanded));document.querySelector('#primary-nav')?.classList.toggle('is-open',!expanded);});
 document.querySelector('#language')?.addEventListener('change',(event)=>{window.location.assign((event.target as HTMLSelectElement).value);});
 document.querySelectorAll<HTMLButtonElement>('[data-image]').forEach(button=>button.addEventListener('click',()=>{const main=document.querySelector<HTMLImageElement>('#main-image');if(main){main.src=button.dataset.image!;document.querySelectorAll('[data-image]').forEach(b=>b.classList.toggle('selected',b===button));}}));
 document.querySelectorAll<HTMLSelectElement>('.sku-select').forEach(select=>select.addEventListener('change',()=>{const img=select.selectedOptions[0]?.dataset.img;const main=document.querySelector<HTMLImageElement>('#main-image');if(img&&main)main.src=img;}));
 document.querySelectorAll<HTMLImageElement>('.product-photo img,.hero-image img').forEach(img=>img.addEventListener('error',()=>{img.style.opacity='0';img.parentElement?.classList.add('image-failed');},{once:true}));
</script>
</body></html>
