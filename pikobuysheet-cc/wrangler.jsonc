{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pikobuysheet-cc",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./dist/client"
  },
  "routes": [
    {
      "pattern": "pikobuysheet.cc",
      "custom_domain": true
    },
    {
      "pattern": "www.pikobuysheet.cc",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SOURCE_CACHE",
      "id": "482b2f82d5674983bbbe59a261f17983"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  }
}
